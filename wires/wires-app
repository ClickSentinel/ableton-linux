#!/usr/bin/env bash
# The applications installed on this machine: list them, remove one.
#
# The apps directory is the census - an application exists because
# ~/wires/apps/<name>/ does, with a launcher of the same name inside - so
# listing is a walk and removal is a directory. Nothing here touches a Plug:
# what an application installed into a prefix stays until the Plug goes.
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
for _l in "$here/runtime-env.sh" "$HOME/wires/lib/runtime-env.sh" \
          "$here/../wires/runtime-env.sh"; do
    [ -r "$_l" ] && . "$_l" && break
done
command -v wires_app_names >/dev/null 2>&1 || {
    echo "!! runtime-env.sh not found next to $0 or in ~/wires/lib" >&2; exit 1; }

BIN="$HOME/.local/bin"

cmd_list() {
    local n=0 name dir ver min path
    printf '  %-24s %-30s %-4s %s\n' "APP" "VERSION" "ABI" "PATH"
    while read -r name; do
        [ -n "$name" ] || continue
        n=$((n+1))
        dir="$(wires_home)/apps/$name"
        ver="$(head -1 "$dir/VERSION" 2>/dev/null || echo '-')"
        min="$(wires_abi_field "$dir/$name" WIRES_ABI_MIN 2>/dev/null || echo 1)"
        path="$dir"
        path="$(wires_abbrev_home "$path")"
        printf '  %-24.24s %-30.30s %-4s %s\n' "$name" "$ver" "$min" "$path"
    done < <(wires_app_names)
    [ "$n" -gt 0 ] || echo "  (none)"
}

# Where this application's executable sits inside a Plug, as its launcher
# records it. Only launchers this verb generated carry the line; an application
# with a hand-written launcher answers nothing, which is the honest answer -
# guessing which registry entry belongs to it is how the wrong thing gets
# adopted twice.
app_rel_exe() {
    sed -n 's#^EXE="\$WINEPREFIX/\(.*\)"$#\1#p' "$1" 2>/dev/null | head -1
}

# A name to file the application under. The executable's own name, not the
# DisplayName: DisplayName is a sentence ("Notepad++ (64-bit x64)") and this
# becomes a directory and a command.
app_slug() {
    local s="${1##*/}"
    s="${s%.[Ee][Xx][Ee]}"
    s="$(printf '%s' "$s" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._+-' '-')"
    s="${s%%-}"; s="${s##-}"
    printf '%s\n' "$s"
}

# Write the application record for something already installed in a Plug: the
# generated launcher, VERSION, and the PATH link. The launcher is generated
# rather than copied from a template file, so there is no second artefact to
# stage into a kit and keep in step with this one.
adopt_entry() {
    local name="$1" exe="$2" ver="$3" plug="$4" disp="$5"
    local dir
    dir="$(wires_home)/apps/$name"
    mkdir -p "$dir" "$BIN"
    # The exe is recorded relative to the Plug, never absolutely: a launcher
    # holding an absolute path would follow the Plug it was adopted from rather
    # than the Plug selection resolves to, and per-project Plugs are the whole
    # point of the selection. Consequence: one record can front the same
    # software in several Plugs.
    local rel="${exe#"${plug%/}"/}"
    cat > "$dir/$name" <<LAUNCHER
#!/usr/bin/env bash
# $disp, under the Wires runtime. Generated by \`wires app adopt\`.
set -u
WIRES_ABI_MIN=1
for _l in "\$(dirname "\$0")/../../lib/runtime-env.sh" "\$HOME/wires/lib/runtime-env.sh"; do
    [ -r "\$_l" ] && . "\$_l" && break
done
command -v wires_runtime_path >/dev/null 2>&1 || {
    echo "!! runtime-env.sh not found; is Wires installed?" >&2; exit 1; }
if [ "\${WIRES_ABI_OLDEST:-1}" -gt "\$WIRES_ABI_MIN" ]; then
    echo "$name: the installed Wires (generation \${WIRES_ABI:-?}) no longer supports" >&2
    echo "  this launcher (generation \$WIRES_ABI_MIN). Reinstall it." >&2
    exit 1
fi
wires_bind_runtime
EXE="\$WINEPREFIX/$rel"
[ -f "\$EXE" ] || {
    echo "$name: not installed in the selected Plug (\$WINEPREFIX)" >&2
    echo "  another Plug may hold it: wires plug list, then wires plug use <name>" >&2
    exit 1; }
args=()
for a in "\$@"; do
    if [ -f "\$a" ]; then w="\$(winepath -w "\$a" 2>/dev/null || true)"; [ -n "\$w" ] && a="\$w"; fi
    args+=("\$a")
done
exec wine "\$EXE" \${args[@]+"\${args[@]}"}
LAUNCHER
    chmod 755 "$dir/$name"
    printf '%s\n' "${ver:-unknown}" > "$dir/VERSION"
    ln -sfn "$dir/$name" "$BIN/$name"
}

# Turn registry entries into application records. Takes the keys to consider and
# returns non-zero when it adopted nothing, because the caller treats that as
# the failure it is.
#
# The executable comes from DisplayIcon where that is an .exe, which is usual,
# and otherwise from the largest .exe directly under InstallLocation, which is
# the application far more often than not. An entry that yields neither is named
# and skipped rather than guessed at.
adopt_matching() {
    local p="${1%/}" keys="$2" name="$3"
    local key disp icon ver loc rest exe this n=0
    while IFS="$WIRES_FS" read -r key disp icon ver loc rest; do
        [ -n "$key" ] || continue
        printf '%s\n' "$keys" | grep -qxF "$key" || continue
        disp="$(wires_reg_unescape "$disp")"
        icon="$(wires_reg_unescape "$icon")"
        loc="$(wires_reg_unescape "$loc")"
        exe=""
        [ -z "$icon" ] || exe="$(wires_win_path "$p" "$icon")"
        case "$exe" in *.[Ee][Xx][Ee]) ;; *) exe="" ;; esac
        if [ -z "$exe" ] && [ -n "$loc" ]; then
            exe="$(find "$(wires_win_path "$p" "$loc")" -maxdepth 1 -iname '*.exe' \
                    -printf '%s\t%p\n' 2>/dev/null | sort -rn | head -1 | cut -f2)"
        fi
        [ -n "$exe" ] && [ -f "$exe" ] || {
            echo "   skipped $disp (no executable found)" >&2; continue; }
        this="$name"; [ -n "$this" ] || this="$(app_slug "$exe")"
        adopt_entry "$this" "$exe" "$ver" "$p" "$disp"
        echo "   $disp ${ver:-unknown}  ->  $this"
        n=$((n+1))
    done < <(wires_plug_entries "$p")
    [ "$n" -gt 0 ]
}

# Wire up software already sitting in a Plug: anything put there by hand, or by
# an installer run outside Wires. Wine already ran the installer; what Wine does
# not give you is a launcher on PATH, a census entry, a version or an ABI floor,
# and all of those can be read out of what the installer itself wrote down.
cmd_adopt() {
    local plug="" name="" want=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --plug)   shift; plug="${1:-}" ;;
            --plug=*) plug="${1#--plug=}" ;;
            --name)   shift; name="${1:-}" ;;
            --name=*) name="${1#--name=}" ;;
            -*) echo "!! unknown option: $1" >&2; return 2 ;;
            *)  [ -z "$want" ] || { echo "!! one at a time: $1" >&2; return 2; }
                want="$1" ;;
        esac
        shift
    done
    local p
    if [ -n "$plug" ]; then p="$(wires_plugs_dir)/$plug"; else p="$(wires_plug_path)"; fi
    [ -d "$p" ] || { echo "!! no such Plug: ${plug:-$p}" >&2; return 1; }

    # Everything registered that no application record already fronts. The
    # comparison is on the executable, not the name: what an application is
    # called in a menu and what it is called as a command are different things.
    local known="" a rel
    while read -r a; do
        [ -n "$a" ] || continue
        rel="$(app_rel_exe "$(wires_home)/apps/$a/$a")"
        [ -z "$rel" ] || known="$known${p%/}/$rel"$'\n'
    done < <(wires_app_names)

    local key disp icon ver loc rest exe dn cand="" seen="" shown=0
    while IFS="$WIRES_FS" read -r key disp icon ver loc rest; do
        [ -n "$key" ] || continue
        dn="$(wires_reg_unescape "$disp")"
        # Every name this index carries, filtered or not - the reconciliation
        # below asks what the census knows that this reader never saw.
        seen="$seen$dn"$'\n'
        icon="$(wires_reg_unescape "$icon")"
        exe=""; [ -z "$icon" ] || exe="$(wires_win_path "$p" "$icon")"
        case "$exe" in *.[Ee][Xx][Ee]) ;; *) exe="" ;; esac
        # Already fronted by a record: skip. An entry whose DisplayIcon is not
        # an .exe stays a candidate - adopt_matching looks harder than this does.
        if [ -n "$exe" ] && printf '%s\n' "$known" | grep -qxF "$exe"; then
            continue
        fi
        # A platform runtime is not an application, and the census has always
        # said so; this reader is raw, so the policy is applied here.
        if printf '%s\n' "$dn" | grep -qE "$(wires_platform_runtimes)"; then
            continue
        fi
        if [ -n "$want" ]; then
            case "$dn" in *"$want"*) ;; *) continue ;; esac
        fi
        cand="$cand$key"$'\n'
        shown=$((shown+1))
    done < <(wires_plug_entries "$p")

    # What the census knows about that this reader cannot reach.
    # RegisteredApplications carries a name and a pointer to a Capabilities key
    # and nothing else - no icon, no version, no install location - so an
    # application registering only there is real, present and not adoptable.
    # Ableton Live is one, and on a real Live prefix it is the only tenant.
    # Naming it is the difference between "there is nothing here" and "there is
    # something here I cannot wire up".
    local unreachable="" t
    while read -r t; do
        [ -n "$t" ] || continue
        printf '%s\n' "$seen" | grep -qxF "$t" && continue
        [ -z "$want" ] || case "$t" in *"$want"*) ;; *) continue ;; esac
        unreachable="$unreachable$t"$'\n'
    done < <(wires_plug_tenants "$p")

    if [ -n "$unreachable" ]; then
        echo "   present in ${p##*/} but not adoptable - registered without an" >&2
        echo "   executable path, so there is nothing to point a launcher at:" >&2
        printf '%s' "$unreachable" | sed 's/^/     /' >&2
        echo "   Software like this is launched by whatever installed it." >&2
    fi

    [ "$shown" -gt 0 ] || {
        echo "Nothing in ${p##*/} is waiting to be adopted." >&2
        echo "   wires plug list shows what is installed where." >&2
        return 1; }
    echo "== adopting from ${p##*/} =="
    adopt_matching "$p" "$cand" "$name" \
        || { echo "!! nothing adoptable found" >&2; return 1; }
    echo
    echo "OK. Launch it by name, or see it with: wires app list"
}

cmd_rm() {
    local want yes parsed dir
    parsed="$(wires_rm_args "$@")" || return $?
    { IFS= read -r want; IFS= read -r yes; } <<<"$parsed"
    [ -n "$want" ] || { echo "!! usage: wires app rm <name> [-y]" >&2; return 2; }
    dir="$(wires_home)/apps/$want"
    [ -d "$dir" ] || {
        echo "!! no such application: $want" >&2
        echo "   installed:" >&2; wires_app_names | sed 's/^/     /' >&2
        return 1; }

    if [ -z "$yes" ]; then
        echo "This removes the $want launcher and its files under $dir."
        echo "Plugs and anything installed inside them are untouched."
        wires_ask_tty "Remove it? [y/N] "
        case "$?" in
            0) ;;
            2) echo "!! no terminal to confirm on; pass -y if you mean it" >&2; return 1 ;;
            *) echo "cancelled"; return 1 ;;
        esac
    fi

    # Only the link this application owns: a same-named command from anywhere
    # else is not ours to delete.
    if [ "$(readlink "$BIN/$want" 2>/dev/null)" = "$dir/$want" ]; then
        rm -f "$BIN/$want"
    fi
    rm -rf "${dir:?}"
    echo "removed $want; Plugs and their contents are untouched"
}

short_usage() {
    cat <<'EOF'
usage: wires app {list|adopt|rm}           `wires app help` for detail

  wires app list                  every installed application
  wires app adopt [match]         wire up software already in a Plug
  wires app rm <name> [-y]        remove one; Plugs are untouched
EOF
}

long_usage() {
    cat <<'EOF'
The applications installed on this machine.

  wires app list                  every installed application, with version,
                                  declared ABI floor, and path
  wires app adopt [match]         wire up software already installed in a Plug:
      [--plug N] [--name N]       read what its installer registered, generate
                                  a launcher on PATH, record a version. Wine
                                  ran the installer; this is the part Wine
                                  does not do. Software that registers no
                                  executable path is named and skipped
  wires app rm <name> [-y]        remove the launcher and the application's
                                  files under ~/wires/apps; anything it
                                  installed inside a Plug stays until the
                                  Plug goes
EOF
}

case "${1:-list}" in
    list|ls)        cmd_list ;;
    adopt)          shift; cmd_adopt "$@" ;;
    rm|remove)      shift; cmd_rm "$@" ;;
    -h|--help|help) long_usage ;;
    *) echo "!! unknown command: $1" >&2; short_usage >&2; exit 1 ;;
esac
