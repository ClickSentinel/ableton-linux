#!/usr/bin/env bash
# The applications installed on this machine: list them, remove one.
#
# The apps directory is the census - an application exists because
# ~/wires/apps/<name>/ does, with a launcher of the same name inside - so
# listing is a walk and removal is a directory. Nothing here touches a Plug:
# what an application installed into a prefix stays until the Plug goes.
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
for _l in "$here/runtime-env.sh" "$HOME/wires/lib/runtime-env.sh" \
          "$here/../wires/runtime-env.sh"; do
    [ -r "$_l" ] && . "$_l" && break
done
command -v wires_app_names >/dev/null 2>&1 || {
    echo "!! runtime-env.sh not found next to $0 or in ~/wires/lib" >&2; exit 1; }

BIN="$HOME/.local/bin"

cmd_list() {
    local n=0 name dir ver min path
    printf '  %-24s %-30s %-4s %s\n' "APP" "VERSION" "ABI" "PATH"
    while read -r name; do
        [ -n "$name" ] || continue
        n=$((n+1))
        dir="$(wires_home)/apps/$name"
        ver="$(head -1 "$dir/VERSION" 2>/dev/null || echo '-')"
        min="$(wires_abi_field "$dir/$name" WIRES_ABI_MIN 2>/dev/null || echo 1)"
        path="$dir"
        path="$(wires_abbrev_home "$path")"
        printf '  %-24.24s %-30.30s %-4s %s\n' "$name" "$ver" "$min" "$path"
    done < <(wires_app_names)
    [ "$n" -gt 0 ] || echo "  (none)"
}

# Where this application's executable sits inside a Plug, as its launcher
# records it. Only launchers this verb generated carry the line; an application
# with a hand-written launcher answers nothing, which is the honest answer -
# guessing which registry entry belongs to it is how the wrong thing gets
# uninstalled.
app_rel_exe() {
    sed -n 's#^EXE="\$WINEPREFIX/\(.*\)"$#\1#p' "$1" 2>/dev/null | head -1
}

# The Uninstall entry covering an executable in this Plug: the one whose
# DisplayIcon is that file, or whose InstallLocation contains it. Matched by
# path rather than by name because a DisplayName is a sentence and this has to
# be exact - removing software is not a place for a fuzzy match.
payload_entry() {
    local plug="${1%/}" exe="$2" key disp icon ver loc rest
    while IFS=$'\037' read -r key disp icon ver loc rest; do
        [ -n "$key" ] || continue
        if [ -n "$icon" ] && [ "$(wires_win_path "$plug" "$(wires_reg_unescape "$icon")")" = "$exe" ]; then
            printf '%s\037%s\037%s\n' "$key" "$(wires_reg_unescape "$disp")" "$(wires_reg_unescape "$rest")"
            return 0
        fi
        if [ -n "$loc" ]; then
            local d; d="$(wires_win_path "$plug" "$(wires_reg_unescape "$loc")")"
            case "$exe" in "${d%/}"/*)
                printf '%s\037%s\037%s\n' "$key" "$(wires_reg_unescape "$disp")" "$(wires_reg_unescape "$rest")"
                return 0 ;;
            esac
        fi
    done < <(wires_plug_entries "$plug")
    return 1
}

# Run what the application registered as its own removal. The string is a
# Windows command line - a quoted path and switches - so it is split rather
# than handed to a shell.
#
# The exit code is not the answer. NSIS and Inno uninstallers copy themselves
# to a temporary directory and relaunch, so the process started here returns
# immediately and successfully while the real work has not begun; wineserver -w
# waits for the whole session, and whether the registry entry is gone
# afterwards is the only honest check.
run_uninstaller() {
    local plug="${1%/}" cmdline="$2" rt="$3" exe args
    case "$cmdline" in
        \"*) exe="${cmdline#\"}"; exe="${exe%%\"*}"; args="${cmdline#*\" }" 
             [ "$args" != "$cmdline" ] || args="" ;;
        *)   exe="${cmdline%% *}"; args="${cmdline#* }"
             [ "$args" != "$cmdline" ] || args="" ;;
    esac
    exe="$(wires_win_path "$plug" "$exe")"
    [ -f "$exe" ] || { echo "!! the recorded uninstaller is not there: $exe" >&2; return 1; }
    # shellcheck disable=SC2086  # switches are a word list by construction
    WINEPREFIX="$plug" WINEDLLOVERRIDES="mscoree,mshtml,winemenubuilder.exe=" \
        "$rt/bin/wine" "$exe" $args >/dev/null 2>&1 || true
    WINEPREFIX="$plug" "$rt/bin/wineserver" -w
}

cmd_rm() {
    local want="" yes="" dir payload=0 plugname=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -y|--yes)   yes=1 ;;
            --payload)  payload=1 ;;
            --plug)     shift; plugname="${1:-}" ;;
            --plug=*)   plugname="${1#--plug=}" ;;
            -*)         echo "!! unknown option: $1" >&2; return 2 ;;
            *)          [ -z "$want" ] || { echo "!! one name at a time: $1" >&2; return 2; }
                        want="$1" ;;
        esac
        shift
    done
    [ -n "$want" ] || { echo "!! usage: wires app rm <name> [-y] [--payload [--plug N]]" >&2; return 2; }
    dir="$(wires_home)/apps/$want"
    [ -d "$dir" ] || {
        echo "!! no such application: $want" >&2
        echo "   installed:" >&2; wires_app_names | sed 's/^/     /' >&2
        return 1; }

    # The payload is Plug-scoped and the record is not: the launcher resolves
    # its executable through selection, so one record can front the same
    # software installed in several Plugs. There is no right Plug to guess, so
    # this takes the selected one unless told otherwise, and always names it.
    local plug="" rel="" entry="" ekey="" edisp="" ecmd="" rt=""
    if [ "$payload" -eq 1 ]; then
        if [ -n "$plugname" ]; then plug="$(wires_plugs_dir)/$plugname"; else plug="$(wires_plug_path)"; fi
        [ -d "$plug" ] || { echo "!! no such Plug: ${plugname:-$plug}" >&2; return 1; }
        rel="$(app_rel_exe "$dir/$want")"
        [ -n "$rel" ] || {
            echo "!! $want's launcher does not record where its executable is, so there" >&2
            echo "   is no way to tell which installed software is its own. Remove it" >&2
            echo "   from inside the Plug, or drop --payload to remove the record only." >&2
            return 1; }
        entry="$(payload_entry "$plug" "${plug%/}/$rel")" || {
            echo "!! nothing matching $want is registered in ${plug##*/}." >&2
            echo "   Plugs holding it: wires plug list" >&2
            return 1; }
        IFS=$'\037' read -r ekey edisp ecmd <<<"$entry"
        [ -n "$ecmd" ] || { echo "!! $edisp registered no way to uninstall itself" >&2; return 1; }
        rt="$(wires_runtime_path)"
        [ -x "$rt/bin/wine" ] || { echo "!! no runtime installed" >&2; return 1; }
    fi

    if [ -z "$yes" ]; then
        echo "This removes the $want launcher and its files under $dir."
        if [ "$payload" -eq 1 ]; then
            echo "It ALSO runs $edisp's own uninstaller inside the ${plug##*/} Plug,"
            echo "which removes the software and anything it keeps beside it."
            echo "Other Plugs holding it are untouched."
        else
            echo "Plugs and anything installed inside them are untouched."
        fi
        wires_ask_tty "Remove it? [y/N] "
        case "$?" in
            0) ;;
            2) echo "!! no terminal to confirm on; pass -y if you mean it" >&2; return 1 ;;
            *) echo "cancelled"; return 1 ;;
        esac
    fi

    if [ "$payload" -eq 1 ]; then
        echo "== removing $edisp from ${plug##*/} =="
        run_uninstaller "$plug" "$ecmd" "$rt" || return 1
        if wires_plug_entries "$plug" | cut -f1 | grep -qxF "$ekey"; then
            echo "!! $edisp is still registered in ${plug##*/}; its uninstaller did not" >&2
            echo "   finish. The application record is left in place." >&2
            return 1
        fi
        echo "   gone"
    fi

    # Only the link this application owns: a same-named command from anywhere
    # else is not ours to delete.
    if [ "$(readlink "$BIN/$want" 2>/dev/null)" = "$dir/$want" ]; then
        rm -f "$BIN/$want"
    fi
    rm -rf "${dir:?}"
    echo "removed $want; Plugs and their contents are untouched"
}

# Which silent switch this installer takes, or nothing if it is not one we
# know. Read out of the file: NSIS names itself and carries an .ndata section,
# Inno and InstallShield name themselves, a Burn bundle carries a wixburn
# section, and an MSI is not a PE at all. grep -a rather than `strings` so this
# works where binutils is absent, which is the same reason validate-runtime.sh
# guards its readelf checks.
#
# Nothing here is load-bearing: an installer we cannot identify is run with its
# window showing, which works for every installer ever made.
installer_flags() {
    local f="$1"
    case "$f" in *.msi|*.MSI) printf 'msi\n'; return ;; esac
    if   grep -qa 'Nullsoft'      "$f" 2>/dev/null; then printf 'nsis\t/S\n'
    elif grep -qa 'Inno Setup'    "$f" 2>/dev/null; then printf 'inno\t/VERYSILENT\t/SUPPRESSMSGBOXES\t/NORESTART\n'
    elif grep -qa 'wixburn'       "$f" 2>/dev/null; then printf 'burn\t/quiet\t/norestart\n'
    elif grep -qa 'InstallShield' "$f" 2>/dev/null; then printf 'installshield\t/s\n'
    fi
}

# A name to file the application under. The executable's own name, not the
# DisplayName: DisplayName is a sentence ("Notepad++ (64-bit x64)") and this
# becomes a directory and a command.
app_slug() {
    local s="${1##*/}"
    s="${s%.[Ee][Xx][Ee]}"
    s="$(printf '%s' "$s" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._+-' '-')"
    s="${s%%-}"; s="${s##-}"
    printf '%s\n' "$s"
}

# Write the application record for something already installed in a Plug: the
# generated launcher, VERSION, and the PATH link. The launcher is generated
# rather than copied from a template file, so there is no second artefact to
# stage into a kit and keep in step with this one.
adopt_entry() {
    local name="$1" exe="$2" ver="$3" plug="$4" disp="$5"
    local dir
    dir="$(wires_home)/apps/$name"
    mkdir -p "$dir" "$BIN"
    # The exe is recorded relative to the Plug, never absolutely: a launcher
    # holding an absolute path would follow the Plug it was installed from
    # rather than the Plug selection resolves to, and per-project Plugs are the
    # whole point of the selection.
    local rel="${exe#"${plug%/}"/}"
    cat > "$dir/$name" <<LAUNCHER
#!/usr/bin/env bash
# $disp, under the Wires runtime. Generated by \`wires app install\`.
set -u
WIRES_ABI_MIN=1
for _l in "\$(dirname "\$0")/../../lib/runtime-env.sh" "\$HOME/wires/lib/runtime-env.sh"; do
    [ -r "\$_l" ] && . "\$_l" && break
done
command -v wires_runtime_path >/dev/null 2>&1 || {
    echo "!! runtime-env.sh not found; is Wires installed?" >&2; exit 1; }
if [ "\${WIRES_ABI_OLDEST:-1}" -gt "\$WIRES_ABI_MIN" ]; then
    echo "$name: the installed Wires (generation \${WIRES_ABI:-?}) no longer supports" >&2
    echo "  this launcher (generation \$WIRES_ABI_MIN). Reinstall it." >&2
    exit 1
fi
wires_bind_runtime
EXE="\$WINEPREFIX/$rel"
[ -f "\$EXE" ] || {
    echo "$name: not installed in the selected Plug (\$WINEPREFIX)" >&2
    echo "  another Plug may hold it: wires plug list, then wires plug use <name>" >&2
    exit 1; }
args=()
for a in "\$@"; do
    if [ -f "\$a" ]; then w="\$(winepath -w "\$a" 2>/dev/null || true)"; [ -n "\$w" ] && a="\$w"; fi
    args+=("\$a")
done
exec wine "\$EXE" \${args[@]+"\${args[@]}"}
LAUNCHER
    chmod 755 "$dir/$name"
    printf '%s\n' "${ver:-unknown}" > "$dir/VERSION"
    ln -sfn "$dir/$name" "$BIN/$name"
}

# Run a Windows installer into the selected Plug and wire up whatever it left
# behind. The running is the part Wine already does; the wiring is the part
# that did not exist, and it is done by reading the registry the installer just
# wrote rather than by asking anyone to restate it.
cmd_install() {
    local src="" plug="" name="" visible=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --plug)    shift; plug="${1:-}" ;;
            --plug=*)  plug="${1#--plug=}" ;;
            --name)    shift; name="${1:-}" ;;
            --name=*)  name="${1#--name=}" ;;
            --visible) visible=1 ;;
            -*) echo "!! unknown option: $1" >&2; return 2 ;;
            *)  [ -z "$src" ] || { echo "!! one installer at a time: $1" >&2; return 2; }
                src="$1" ;;
        esac
        shift
    done
    [ -n "$src" ] || { echo "!! usage: wires app install <installer.exe> [--plug N] [--name N] [--visible]" >&2; return 2; }
    [ -f "$src" ] || { echo "!! no such file: $src" >&2; return 1; }
    src="$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"

    local rt; rt="$(wires_runtime_path)"
    [ -x "$rt/bin/wine" ] || { echo "!! no runtime installed ($rt holds no wine)" >&2; return 1; }
    local p
    if [ -n "$plug" ]; then p="$(wires_plugs_dir)/$plug"; else p="$(wires_plug_path)"; fi
    [ -d "$p" ] || { echo "!! no such Plug: ${plug:-$p}" >&2; return 1; }

    # First boot writes the registry this reads afterwards; idempotent once done.
    echo "== preparing ${p##*/} =="
    WINEPREFIX="$p" WINEDLLOVERRIDES="mscoree,mshtml,winemenubuilder.exe=" \
        "$rt/bin/wineboot" -u >/dev/null 2>&1
    WINEPREFIX="$p" "$rt/bin/wineserver" -w

    local before after
    before="$(wires_plug_entries "$p" | cut -f1)"

    local kind="" flags=()
    if [ "$visible" -eq 0 ]; then
        local IFS_SAVE="$IFS"; IFS=$'\t'
        read -r -a flags <<<"$(installer_flags "$src")"
        IFS="$IFS_SAVE"
        kind="${flags[0]:-}"
        flags=("${flags[@]:1}")
    fi
    if [ -n "$kind" ]; then
        echo "== installing (${kind}, silent) =="
    else
        echo "== installing =="
        echo "   This installer was not recognised, so its window will open."
        echo "   Click through it; what you install is picked up afterwards."
    fi
    # winemenubuilder off: left on, an installer scatters desktop entries that
    # point at stock wine and the wrong prefix.
    if [ "$kind" = msi ]; then
        WINEPREFIX="$p" WINEDLLOVERRIDES="mscoree,mshtml,winemenubuilder.exe=" \
            "$rt/bin/wine" msiexec /i "$src" /qn || true
    else
        WINEPREFIX="$p" WINEDLLOVERRIDES="mscoree,mshtml,winemenubuilder.exe=" \
            "$rt/bin/wine" "$src" ${flags[@]+"${flags[@]}"} || true
    fi
    WINEPREFIX="$p" "$rt/bin/wineserver" -w

    after="$(wires_plug_entries "$p" | cut -f1)"
    local fresh
    fresh="$(comm -13 <(printf '%s\n' "$before" | sort -u) <(printf '%s\n' "$after" | sort -u))"
    [ -n "$fresh" ] || {
        echo "!! nothing new registered itself in ${p##*/}." >&2
        echo "   The installer may have been cancelled, or this application does not" >&2
        echo "   register - name its executable with \`wires app adopt\` instead." >&2
        return 1; }

    local key disp icon ver loc rest exe n=0
    while IFS=$'\037' read -r key disp icon ver loc rest; do
        [ -n "$key" ] || continue
        printf '%s\n' "$fresh" | grep -qxF "$key" || continue
        disp="$(wires_reg_unescape "$disp")"
        icon="$(wires_reg_unescape "$icon")"
        loc="$(wires_reg_unescape "$loc")"
        exe=""
        [ -z "$icon" ] || exe="$(wires_win_path "$p" "$icon")"
        case "$exe" in *.[Ee][Xx][Ee]) ;; *) exe="" ;; esac
        if [ -z "$exe" ] && [ -n "$loc" ]; then
            # No usable DisplayIcon: the largest executable directly under
            # InstallLocation is the application far more often than not.
            exe="$(find "$(wires_win_path "$p" "$loc")" -maxdepth 1 -iname '*.exe' \
                    -printf '%s\t%p\n' 2>/dev/null | sort -rn | head -1 | cut -f2)"
        fi
        [ -n "$exe" ] && [ -f "$exe" ] || {
            echo "   skipped $disp (no executable found)" >&2; continue; }
        local this="$name"; [ -n "$this" ] || this="$(app_slug "$exe")"
        adopt_entry "$this" "$exe" "$ver" "$p" "$disp"
        echo "   $disp $ver  ->  $this"
        n=$((n+1))
    done < <(wires_plug_entries "$p")

    [ "$n" -gt 0 ] || { echo "!! nothing adoptable was installed" >&2; return 1; }
    echo
    echo "OK. Launch it by name, or see it with: wires app list"
}

short_usage() {
    cat <<'EOF'
usage: wires app {list|rm}                 `wires app help` for detail

  wires app list                  every installed application
  wires app install <exe>         run a Windows installer, wire up the result
  wires app rm <name> [-y]        remove one; Plugs are untouched
  wires app rm <name> --payload   ...and uninstall it from the Plug too
EOF
}

long_usage() {
    cat <<'EOF'
The applications installed on this machine.

  wires app list                  every installed application, with version,
                                  declared ABI floor, and path
  wires app rm <name> [-y]        remove the launcher and the application's
                                  files under ~/wires/apps; anything it
                                  installed inside a Plug stays until the
                                  Plug goes
      --payload [--plug N]        also run the application's own uninstaller
                                  inside a Plug - the selected one unless
                                  named. One record can front the same
                                  software in several Plugs, so this only
                                  ever removes it from one
EOF
}

case "${1:-list}" in
    list|ls)        cmd_list ;;
    install|add)    shift; cmd_install "$@" ;;
    rm|remove)      shift; cmd_rm "$@" ;;
    -h|--help|help) long_usage ;;
    *) echo "!! unknown command: $1" >&2; short_usage >&2; exit 1 ;;
esac
