#!/usr/bin/env bash
# Is there a newer runtime on this channel, and do you want it?
#
#   ableton-update                    check this machine's channel, and offer it
#   ableton-update --check            say what is available; change nothing
#   ableton-update --channel nightly  switch channel and update to it
#   ableton-update --yes              do not ask (still refuses a Wine base change)
#
# Nothing checked for updates before this. A user on a daily channel had no way
# to know a build existed short of opening the releases page, and the install
# prompt compared two version strings that are identical between releases.
#
# Never runs unattended by itself. Swapping the Wine runtime under a licensed
# Live install is not a background task.
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
for _l in "$here/runtime-env.sh" "$HOME/.local/share/ableton-wine/runtime-env.sh" \
          "$here/../scripts/runtime-env.sh"; do
    # shellcheck source=scripts/runtime-env.sh
    [ -r "$_l" ] && . "$_l" && break
done
command -v ableton_manifest_url >/dev/null 2>&1 || {
    echo "!! runtime-env.sh not found next to $0 or in ~/.local/share/ableton-wine" >&2; exit 1; }

CHECK=0; ASSUME_YES=0; WANT_CHANNEL=""
while [ $# -gt 0 ]; do
    case "$1" in
        --check)    CHECK=1 ;;
        --yes|-y)   ASSUME_YES=1 ;;
        --channel)  shift; WANT_CHANNEL="${1:-}"
                    [ -n "$WANT_CHANNEL" ] || { echo "!! --channel needs a name" >&2; exit 1; } ;;
        --channel=*) WANT_CHANNEL="${1#--channel=}" ;;
        -h|--help)  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "!! unknown option: $1 (try --help)" >&2; exit 1 ;;
    esac
    shift
done

# A channel names a symlink and selects a URL, so it is checked against the
# allowlist rather than trusted — the same constraint that ended the source-repo
# experiment. ableton_channel does that; asking it is how the value is validated.
if [ -n "$WANT_CHANNEL" ]; then
    if [ "$(ABLETON_CHANNEL="$WANT_CHANNEL" ableton_channel 2>/dev/null)" != "$WANT_CHANNEL" ]; then
        echo "!! not a channel: $WANT_CHANNEL" >&2; exit 1
    fi
    CHANNEL="$WANT_CHANNEL"
else
    CHANNEL="$(ableton_channel)"
fi

url="$(ableton_manifest_url "$CHANNEL")" || { echo "!! no manifest URL for $CHANNEL" >&2; exit 1; }
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

echo "== channel: $CHANNEL =="
echo "   $url"
if ! curl -fsSL --retry 2 --max-time 60 -o "$tmp/manifest.txt" "$url"; then
    echo "!! could not fetch the manifest. Offline, or the channel has published nothing yet." >&2
    exit 1
fi
ableton_manifest_valid "$tmp/manifest.txt" || {
    echo "!! the manifest is incomplete; refusing to act on it" >&2
    sed 's/^/   /' "$tmp/manifest.txt" >&2; exit 1; }

want_commit="$(ableton_buildinfo_field "$tmp/manifest.txt" source-commit)"
want_at="$(ableton_buildinfo_field "$tmp/manifest.txt" built-at)"
want_wine="$(ableton_buildinfo_field "$tmp/manifest.txt" wine)"
want_ver="$(ableton_buildinfo_field "$tmp/manifest.txt" dist-version)"
installer="$(ableton_buildinfo_field "$tmp/manifest.txt" installer)"
want_sha="$(ableton_buildinfo_field "$tmp/manifest.txt" sha256)"

root="$(ableton_wine_root)"
have_info="$root/ABLETON-WINE-BUILD-INFO.txt"
have_commit="$(ableton_buildinfo_field "$have_info" source-commit)"
have_at="$(ableton_buildinfo_field "$have_info" built-at)"
have_wine="$(ableton_buildinfo_field "$have_info" wine)"

echo "   available: $want_ver  ${want_at:-—}  ${want_wine:-?}"
echo "   installed: $(ableton_runtime_id "$root" 2>/dev/null || echo 'none')  ${have_at:-—}  ${have_wine:-?}"

# The case that had no answer at all before: same build, nothing to do. Compared
# on source-commit rather than the version, which is identical across every
# nightly between two releases.
if [ -n "$want_commit" ] && [ "$want_commit" = "$have_commit" ] && [ "$CHANNEL" = "$(ableton_channel)" ]; then
    echo
    echo "You already have this build."
    exit 0
fi

# Already in the store from an earlier install? Then this is a channel switch,
# not a download.
container="$(ableton_container_root)"
for e in "$container"/*; do
    [ -d "$e" ] && [ ! -L "$e" ] || continue
    [ "$(ableton_buildinfo_field "$e/ABLETON-WINE-BUILD-INFO.txt" source-commit)" = "$want_commit" ] || continue
    echo
    echo "That build is already installed as ${e##*/} — no download needed."
    [ "$CHECK" -eq 0 ] || exit 0
    ln -sfn "${e##*/}" "$container/$CHANNEL"
    printf '%s\n' "$CHANNEL" > "${XDG_CONFIG_HOME:-$HOME/.config}/ableton-wine/channel"
    echo "channel $CHANNEL -> ${e##*/}"
    exit 0
done

if [ -n "$have_at" ] && [ -n "$want_at" ] && \
   [ "$(printf '%s\n%s\n' "$have_at" "$want_at" | sort | tail -1)" = "$have_at" ]; then
    echo "   (this is OLDER than what you have)"
fi

if [ "$CHECK" -eq 1 ]; then
    echo; echo "An update is available. Run without --check to install it."
    exit 0
fi

# A Wire is bound to a Wine base and cannot be taken back across one. Say it
# before downloading 113M, not after.
if [ -n "$have_wine" ] && [ -n "$want_wine" ] && [ "$have_wine" != "$want_wine" ]; then
    echo
    echo "!! This changes the Wine base: $have_wine -> $want_wine"
    echo "   Your Wire will be re-bootstrapped and cannot be taken back."
    echo "   Refusing. Install it deliberately with the full installer if you mean it."
    exit 1
fi

if ableton_runtime_busy; then
    echo; echo "!! something is running from the runtime. Close Live first." >&2
    exit 1
fi

if [ "$ASSUME_YES" -eq 0 ]; then
    if { : >/dev/tty; } 2>/dev/null; then
        printf '\nDownload and install it? [y/N] ' > /dev/tty
        read -r -t 60 ans < /dev/tty || ans=n
        case "$ans" in y|Y|yes|Yes|YES) ;; *) echo "cancelled"; exit 0 ;; esac
    else
        echo; echo "!! no terminal to confirm on; pass --yes if you mean it" >&2
        exit 1
    fi
fi

echo
echo "== downloading $installer =="
curl -fL --retry 2 --progress-bar -o "$tmp/$installer" \
    "$(ableton_manifest_installer_url "$url" "$installer")" || {
        echo "!! download failed" >&2; exit 1; }

echo "== verifying =="
got="$(sha256sum "$tmp/$installer" | cut -d' ' -f1)"
[ "$got" = "$want_sha" ] || {
    echo "!! checksum mismatch — refusing to install" >&2
    echo "   expected $want_sha" >&2
    echo "   got      $got" >&2
    exit 1; }
echo "   ok"

echo "== installing =="
sh "$tmp/$installer" --runtime-only
