#!/usr/bin/env bash
# Which build of the runtime is in use, and switching between them.
#
# The store makes rollback possible - one directory per build, a channel symlink
# at the live one - and until this existed nothing exposed it. Rolling back was
# `ln -sfn` against a name you had to go and look up.
#
# Switching does not disturb a running Live. The resolver returns the build the
# channel names rather than the channel itself, so a session that has already
# started keeps the build it started with; the next launch picks up the new one.
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
for _l in "$here/runtime-env.sh" "$HOME/works/lib/runtime-env.sh" \
          "$here/../works/runtime-env.sh"; do
    # shellcheck source=works/runtime-env.sh
    [ -r "$_l" ] && . "$_l" && break
done
command -v works_runtime_path >/dev/null 2>&1 || {
    echo "!! runtime-env.sh not found next to $0 or in ~/works/lib" >&2; exit 1; }

container="$(works_runtime_store)"
channel="$container/$(works_channel)"

# Entries only: a directory the id reader can name. Quarantined trees
# (superseded-*, failed-*) and the channel link are not builds you can choose.
entries() {
    local d
    [ -d "$container" ] || return 0
    for d in "$container"/*; do
        [ -d "$d" ] && [ ! -L "$d" ] || continue
        works_is_quarantine "$d" && continue
        [ -n "$(works_runtime_id "$d")" ] || continue
        printf '%s\n' "${d##*/}"
    done
}

# Newest first, by built-at where present. Entries built before that field
# existed have only their version, which ties across every nightly between two
# releases - so they sort as a group rather than pretending to an order.
sorted() {
    local e at ver
    while read -r e; do
        [ -n "$e" ] || continue
        at="$(works_buildinfo_field "$container/$e/ABLETON-WINE-BUILD-INFO.txt" built-at)"
        ver="$(works_buildinfo_field "$container/$e/ABLETON-WINE-BUILD-INFO.txt" dist-version)"
        if [ -n "$at" ]; then printf '1 %s\t%s\n' "$at" "$e"
        else                  printf '0 %s\t%s\n' "$ver" "$e"; fi
    done < <(entries) | sort -rV | cut -f2
}

# Ask a yes/no on the controlling terminal, or fail. Deliberately the pattern
# install.sh already uses: `[ -t 0 ]` answers "is stdin a tty", which is not the
# question - a test harness run from a terminal inherits one and takes the
# interactive branch by accident. Opening /dev/tty is the honest test. The
# timeout matches install.sh's: a prompt nobody answers must not wedge anything.
ask_tty() {
    local prompt="$1" ans=""
    { : >/dev/tty; } 2>/dev/null || return 2      # 2 = no terminal to ask on
    printf '%s' "$prompt" > /dev/tty
    read -r -t 60 ans < /dev/tty || { printf '\n' > /dev/tty 2>/dev/null || true; return 1; }
    case "$ans" in y|Y|yes|Yes|YES) return 0 ;; *) return 1 ;; esac
}

cmd_path() {
    local r; r="$(works_runtime_path)"
    [ -n "$r" ] || { echo "!! no runtime resolved" >&2; return 1; }
    printf '%s\n' "$r"
}

# The Wine base is not in the entry name and should not be - it is derivable,
# and one runtime release is built on one base. But it is the fact that decides
# whether switching is safe for a Plug, so it belongs in front of anyone
# choosing. This is the label; works_base_move is the decision, and the two are
# deliberately not the same read: a label can be missing from a BUILD-INFO and
# still leave a perfectly answerable question about the prefix.
base_of() { works_buildinfo_field "$container/$1/ABLETON-WINE-BUILD-INFO.txt" wine; }

cmd_list() {
    local live e at base path n=0
    live="$(readlink -f "$channel" 2>/dev/null || true)"
    if [ ! -d "$container" ]; then
        echo "No version store yet — this install predates it."
        echo "  runtime: $(works_runtime_path)"
        return 0
    fi
    # The path is spelled out per build rather than left implied by the store
    # root: it is the thing people copy - into a script, a bug report, a `cd` -
    # and reconstructing it by hand from a header and an id invites the typo.
    # $HOME is abbreviated because these are always under it and the width is
    # better spent on the build.
    printf '  %-32s %-12s %-22s %s\n' "BUILD" "WINE" "BUILT" "PATH"
    while read -r e; do
        [ -n "$e" ] || continue
        n=$((n+1))
        at="$(works_buildinfo_field "$container/$e/ABLETON-WINE-BUILD-INFO.txt" built-at)"
        base="$(base_of "$e")"
        path="$container/$e"
        case "$path" in "$HOME"/*) path="~${path#"$HOME"}" ;; esac
        if [ "$container/$e" = "$live" ]; then printf '* %-32.32s %-12s %-22s %s\n' "$e" "${base:-?}" "${at:--}" "$path"
        else                                   printf '  %-32.32s %-12s %-22s %s\n' "$e" "${base:-?}" "${at:--}" "$path"; fi
    done < <(sorted)
    [ "$n" -gt 0 ] || echo "No installed builds found in $container"
    local aside e
    aside=0
    for e in "$container"/*; do
        [ -d "$e" ] && [ ! -L "$e" ] || continue
        works_is_quarantine "$e" && aside=$((aside+1))
    done
    [ "$aside" -eq 0 ] || echo "  ($aside set-aside director$([ "$aside" = 1 ] && echo y || echo ies) not shown; nothing was deleted)"
}

# Stop everything Works is running. install.sh does this internally before it
# replaces a runtime; this is the same thing a person can reach, because the
# refusals that send them here say "close it" about processes with no window to
# close - Wine's services.exe and rpcss.exe outlive Live and hold the prefix.
cmd_stop() {
    local pids n ans
    pids="$(works_all_pids | sort -un)"
    [ -n "$pids" ] || { echo "Nothing is running from the runtime or any Plug."; return 0; }
    n="$(printf '%s\n' "$pids" | grep -c .)"

    # Live is the one thing here with unsaved work to lose, so it is the one
    # thing worth asking about - the same consent install.sh takes before it
    # force-closes, for the same reason. Everything else is Wine's own services,
    # which have nothing to save. No terminal means nobody can answer, so stop
    # rather than assume; -y is how a script says it meant it.
    if [ -n "$(ableton_live_pids 2>/dev/null)" ] && [ "${1:-}" != "-y" ] && [ "${1:-}" != "--yes" ]; then
        if { : >/dev/tty; } 2>/dev/null; then
            echo "!! Ableton Live is running. Stopping it discards unsaved work." >&2
            printf "Stop it anyway? [y/N] " > /dev/tty
            ans=""
            read -r ans < /dev/tty || true
            case "$ans" in [yY]|[yY][eE][sS]) ;; *) echo "Nothing was stopped."; return 1 ;; esac
        else
            echo "!! Live is running and there is no terminal to confirm on; pass -y if you mean it" >&2
            return 1
        fi
    fi
    echo "Stopping $n process(es)."
    printf '%s\n' "$pids" | xargs -r kill 2>/dev/null || true
    for _ in $(seq 1 10); do
        [ -n "$(works_all_pids | sort -un)" ] || { echo "Stopped."; return 0; }
        sleep 0.5
    done
    # Wine's own services do not answer TERM once their server is gone.
    works_all_pids | sort -un | xargs -r kill -9 2>/dev/null || true
    sleep 1
    if [ -n "$(works_all_pids | sort -un)" ]; then
        echo "!! still running after SIGKILL:" >&2
        works_all_pids | sort -un | sed 's/^/     /' >&2
        return 1
    fi
    echo "Stopped."
}

# Pick from a numbered list. Only when there is a terminal to ask on - a script
# that runs `use` with no argument should fail loudly, not block forever.
cmd_pick() {
    local -a names=(); local e i=0 live cur
    [ -d "$container" ] || { echo "!! no version store; nothing to switch between" >&2; return 1; }
    live="$(readlink -f "$channel" 2>/dev/null || true)"
    while read -r e; do [ -n "$e" ] && names+=("$e"); done < <(sorted)
    [ "${#names[@]}" -gt 0 ] || { echo "!! no installed builds" >&2; return 1; }
    if ! { : >/dev/tty; } 2>/dev/null; then
        echo "!! no terminal to ask on; name a build instead:" >&2
        for e in "${names[@]}"; do echo "     works runtime use $e" >&2; done
        return 1
    fi
    for e in "${names[@]}"; do
        i=$((i+1))
        cur=""; [ "$container/$e" = "$live" ] && cur="  (current)"
        printf '  %2d) %-32s %-12s %s%s\n' "$i" "$e" "$(base_of "$e")" \
            "$(works_buildinfo_field "$container/$e/ABLETON-WINE-BUILD-INFO.txt" built-at)" "$cur"
    done
    local ans=""
    printf 'Which build? [1-%d, or q to cancel] ' "${#names[@]}" > /dev/tty
    read -r -t 120 ans < /dev/tty || ans=q
    case "$ans" in
        q|Q|"")      echo "cancelled"; return 0 ;;
        *[!0-9]*)    echo "!! not a number: $ans" >&2; return 1 ;;
    esac
    [ "$ans" -ge 1 ] && [ "$ans" -le "${#names[@]}" ] || { echo "!! out of range: $ans" >&2; return 1; }
    cmd_use "${names[$((ans-1))]}"
}

cmd_use() {
    local want="${1:-}" force="${2:-}" live cur from to
    [ -n "$want" ] || { echo "!! usage: works runtime use <name>|--previous" >&2; return 1; }
    [ -d "$container" ] || { echo "!! no version store; nothing to switch between" >&2; return 1; }

    if [ "$want" = "--previous" ]; then
        cur="$(readlink "$channel" 2>/dev/null || true)"
        want="$(sorted | grep -vxF "$cur" | head -1)"
        [ -n "$want" ] || { echo "!! only one build is installed" >&2; return 1; }
    fi

    [ -d "$container/$want" ] || {
        echo "!! no such build: $want" >&2
        echo "   installed:" >&2; sorted | sed 's/^/     /' >&2
        return 1; }
    [ -n "$(works_runtime_id "$container/$want")" ] || {
        echo "!! $want has no readable BUILD-INFO and is not a runtime you can select" >&2
        return 1; }
    [ -x "$container/$want/bin/wine" ] || {
        echo "!! $want has no bin/wine; refusing to point the channel at it" >&2
        return 1; }

    # Wine compares the prefix's .update-timestamp against the runtime's
    # share/wine/wine.inf and runs wineboot --update when they differ. Forward it
    # does; back it does not support. So the question is not "do these two builds
    # carry different `wine:` strings" - it is "where does this build take each
    # Plug that would run it" - answerable only from the Plug's own stamp. One pinned
    # while the channel moved on, and a clone carrying a binding but no history,
    # both go unasked by any comparison made between two runtimes.
    from="$(base_of "$(readlink "$channel" 2>/dev/null)")"
    to="$(base_of "$want")"
    local -a back=() fwd=() roll=(); local p move
    while read -r p; do
        [ -n "$p" ] || continue
        move="$(works_base_move "$container/$want" "$(works_plugs_dir)/$p")" || {
            echo "!! $p has been booted but will not say which Wine base bootstrapped it," >&2
            echo "   so whether this build would take it backward cannot be answered." >&2
            echo "   Refusing rather than guessing." >&2
            return 1; }
        # refresh - a newer build of the same base - switches in silence, as
        # every update always has; rollback within the base is the store's own
        # feature (`use --previous` exists for it) and gets a note, never a
        # DOWNGRADE warning.
        case "$move" in
            backward) back+=("$p") ;;
            forward)  fwd+=("$p") ;;
            rollback) roll+=("$p") ;;
        esac
    done < <(works_plugs_following "$(works_channel)")

    if [ "${#roll[@]}" -gt 0 ]; then
        echo "note: an older build of the same Wine base; going back for: ${roll[*]}"
    fi
    if [ "${#back[@]}" -gt 0 ] || [ "${#fwd[@]}" -gt 0 ]; then
        [ -z "$from" ] || [ -z "$to" ] || echo "This build is on a different Wine base: $from -> $to"
        if [ "${#back[@]}" -gt 0 ]; then
            echo "  That is a DOWNGRADE for: ${back[*]}"
            echo "  Wine does not support it: those Plugs were bootstrapped against a"
            echo "  newer base and cannot be taken back. Expect breakage, and keep a"
            echo "  copy first."
        fi
        if [ "${#fwd[@]}" -gt 0 ]; then
            echo "  Re-bootstrapped on next launch, and not reversible: ${fwd[*]}"
        fi
        if [ "$force" = "--force" ]; then
            echo "  (--force given)"
        else
            ask_tty "  Continue? [y/N] "
            case "$?" in
                0) ;;
                2) echo "!! refusing a base change without a terminal; pass --force if you mean it" >&2
                   return 1 ;;
                *) echo "cancelled"; return 1 ;;
            esac
        fi
    fi

    # Before the retarget. works_runtime_busy resolves through the channel, so
    # asking afterwards asks whether anything is running from the build being
    # switched *to* — while the note is about the one being switched from.
    local was_busy=""
    works_runtime_busy && was_busy=1
    ln -sfn "$want" "$channel"
    echo "channel -> $want"
    if [ -n "$was_busy" ]; then
        echo "note: something is still running from the previous build. It keeps"
        echo "      the build it started with; this takes effect on the next launch."
    fi
}

# Install a runtime build: stop what runs from the current one, migrate a
# legacy layout, stage and check the tarball, guard every Plug's Wine base,
# promote, prune. Works files and guards the build; the caller vouches for its
# contents through --validate, run against the staged tree before anything is
# promoted. Pinned (WORKS_RUNTIME set) the install is flat with a dated
# rollback and no channel - the pin exists for tests, regression VMs and
# bisecting a build.
#
# A subshell with set -e and its own traps: the rollback logic depends on
# errexit semantics this file does not otherwise run under, and a signal must
# reach the cleanup with a nonzero status or the rollback is skipped - the
# consent prompts are sixty-second windows inviting exactly that Ctrl-C.
cmd_install() {
    (
    set -e
    local tarball="" chan="" validate=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --channel)   shift; chan="${1:-}" ;;
            --channel=*) chan="${1#--channel=}" ;;
            --validate)  shift; validate="${1:-}" ;;
            --validate=*) validate="${1#--validate=}" ;;
            -*) echo "!! runtime install: unknown option $1" >&2; exit 2 ;;
            *)  [ -z "$tarball" ] || { echo "!! one tarball at a time: $1" >&2; exit 2; }
                tarball="$1" ;;
        esac
        shift
    done
    if [ -n "$tarball" ] && [ ! -f "$tarball" ]; then
        echo "!! no such tarball: $tarball" >&2; exit 2
    fi
    case "$chan" in stable|nightly|"") ;; *) echo "!! not a channel: $chan" >&2; exit 2 ;; esac
    [ -z "$validate" ] || [ -x "$validate" ] || {
        echo "!! --validate is not an executable: $validate" >&2; exit 2; }

    local NAME WINE_ROOT WINE_ROOT_DIR STORE stamp stage backup replaced replaced_orig promoted migrated dltmp
    dltmp=""

    # No tarball names the web: the followed channel's manifest says what is
    # current, and the download happens here - before anything is stopped or
    # moved, so a machine is never disturbed for a build that is not there,
    # is already installed, or does not verify.
    if [ -z "$tarball" ]; then
        [ -n "$chan" ] || chan="$(works_channel)"
        local url want_commit have_commit rtname rtsha got
        url="$(works_manifest_url "$chan")" || { echo "!! no manifest URL for $chan" >&2; exit 1; }
        dltmp="$(mktemp -d)"
        echo "== channel: $chan =="
        echo "   $url"
        curl -fsSL --retry 2 --max-time 60 -o "$dltmp/manifest.txt" "$url" || {
            echo "!! could not fetch the manifest. Offline, or the channel has published nothing yet." >&2
            rm -rf "$dltmp"; exit 1; }
        works_manifest_valid "$dltmp/manifest.txt" || {
            echo "!! the manifest is incomplete; refusing to act on it" >&2
            rm -rf "$dltmp"; exit 1; }
        rtname="$(works_buildinfo_field "$dltmp/manifest.txt" runtime)"
        rtsha="$(works_buildinfo_field "$dltmp/manifest.txt" runtime-sha256)"
        if [ -z "$rtname" ] || [ -z "$rtsha" ]; then
            echo "!! this channel's manifest predates runtime-only installs." >&2
            echo "   Use \`works update\` for the full installer, or pass a tarball." >&2
            rm -rf "$dltmp"; exit 1
        fi
        case "$rtname" in */*|*..*) echo "!! the manifest names an unusable runtime path" >&2; rm -rf "$dltmp"; exit 1 ;; esac
        want_commit="$(works_buildinfo_field "$dltmp/manifest.txt" source-commit)"
        have_commit="$(works_buildinfo_field "$(works_runtime_path)/ABLETON-WINE-BUILD-INFO.txt" source-commit 2>/dev/null || true)"
        if [ -n "$want_commit" ] && [ "$want_commit" = "$have_commit" ]; then
            echo "You already have this build."
            rm -rf "$dltmp"; exit 0
        fi
        echo "== downloading $rtname =="
        local progress="-sS"; [ -t 2 ] && progress="--progress-bar"
        curl -fL --retry 2 $progress -o "$dltmp/$rtname" \
            "$(works_manifest_installer_url "$url" "$rtname")" || {
            echo "!! download failed" >&2; rm -rf "$dltmp"; exit 1; }
        got="$(sha256sum "$dltmp/$rtname" | cut -d' ' -f1)"
        [ "$got" = "$rtsha" ] || {
            echo "!! checksum mismatch - refusing to install" >&2
            echo "   expected $rtsha" >&2
            echo "   got      $got" >&2
            rm -rf "$dltmp"; exit 1; }
        echo "   ok"
        tarball="$dltmp/$rtname"
    fi
    [ -n "$chan" ] || chan=stable
    NAME="$(works_runtime_name)"
    WINE_ROOT="$(works_runtime_path)"
    WINE_ROOT_DIR="$(dirname "$WINE_ROOT")"
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    stage=""; backup=""; replaced=""; replaced_orig=""; promoted=0; migrated=0

    cleanup() {
        rc=$?
        trap - EXIT
        if [ "$rc" -ne 0 ]; then
            if [ "$promoted" -eq 1 ] && [ -e "$WINE_ROOT" ]; then
                mv "$WINE_ROOT" "$WINE_ROOT.failed-$stamp" || true
            fi
            if [ -n "$backup" ] && [ -e "$backup" ] && [ ! -e "$WINE_ROOT" ]; then
                mv "$backup" "$WINE_ROOT" || true
            elif [ -n "$backup" ] && [ -e "$backup" ]; then
                echo "!! $WINE_ROOT still present; backup left at $backup" >&2
            fi
            if [ -n "$replaced" ] && [ -d "$replaced" ] && [ -n "$replaced_orig" ]; then
                # A store entry set aside to write over. Put it back, so a
                # failure between the move and the channel retarget does not
                # leave the user without the build they already had.
                rm -rf "$replaced_orig" 2>/dev/null || true
                mv "$replaced" "$replaced_orig" 2>/dev/null || true
            fi
            if [ "$promoted" -eq 1 ] || [ -n "$backup" ]; then
                echo "!! install failed; previous runtime restored" >&2
            elif [ "$migrated" -eq 1 ]; then
                # The migration is deliberately not undone - it only moves
                # trees that stay valid, and rerunning continues from it. A
                # message claiming nothing changed after ~/works has appeared
                # would send whoever is investigating the wrong way.
                echo "!! install aborted; the layout migration had already completed and" >&2
                echo "   stands - rerunning will continue from it" >&2
            else
                echo "!! install aborted; nothing was changed" >&2
            fi
        fi
        [ -z "$stage" ] || rm -rf "$stage"
        [ -z "$dltmp" ] || rm -rf "$dltmp"
        exit "$rc"
    }
    trap cleanup EXIT
    # Without these, a signal reaches the EXIT trap with $? still 0 and the
    # rollback above is skipped.
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # Anything still running from the installed runtime holds the old files
    # open. Stop it all instead of refusing: ask the prefix's wineserver to
    # take the whole session down, and signal processes directly only when
    # that is unavailable or leaves something behind.
    #
    # Live, as opposed to the support processes: the prompt is about unsaved
    # work and only Live has any. Scoped to this runtime, so a Live under an
    # unrelated Wine install is neither prompted for nor killed. (The Live
    # scan is on the shared library's de-Ableton inventory; its exit is the
    # application declaring its process signature.)
    local live_up=0 ans
    [ -z "$(ableton_live_pids)" ] || live_up=1
    if works_runtime_busy; then
        echo "== stop processes using the installed runtime =="
        echo "   $(works_runtime_pids | wc -l) found"
        # Closing Live discards unsaved work, so require an explicit yes.
        # Opening /dev/tty is the only honest terminal test; anything but y -
        # a timeout, an EOF, a bare Enter, no terminal - means nobody
        # consented. Leftover wineserver and winedevice.exe without Live have
        # nothing to save and never reach this.
        if [ "$live_up" -eq 1 ]; then
            if { : >/dev/tty; } 2>/dev/null; then
                echo "!! Live is running. Updating will force-close it. Save your work before continuing." >&2
                printf "Force-close Live? [y/N] " > /dev/tty
                ans=""
                read -r -t 60 ans < /dev/tty || printf '\n' > /dev/tty 2>/dev/null || true
                case "$ans" in
                    y|Y|yes|Yes|YES) ;;
                    *) exit 1 ;;
                esac
            else
                echo "!! Live is running; no terminal to confirm on. Close Live, or rerun from a terminal." >&2
                exit 1
            fi
        fi
        if [ -x "$WINE_ROOT/bin/wineserver" ]; then
            # The prefix as it is now, not where the migration below will put
            # it: on an unmigrated machine the real prefix is still at the
            # legacy path.
            WINEPREFIX="$(works_plug_path_live)" \
                "$WINE_ROOT/bin/wineserver" -k 2>/dev/null || true
            for _ in $(seq 1 20); do
                works_anything_busy || break
                sleep 0.5
            done
        fi
        # works_all_pids, not works_runtime_pids: the environ scan is strictly
        # larger than the exe scan, and a process holding the prefix without
        # executing from the runtime is invisible to the narrower kill.
        if works_anything_busy; then
            works_all_pids | sort -un | xargs -r kill 2>/dev/null || true
            pkill -f '[A]bleton Live.*\.exe|[P]ush2DisplayProcess.exe' 2>/dev/null || true
            for _ in $(seq 1 10); do
                works_anything_busy || break
                sleep 0.5
            done
            works_all_pids | sort -un | xargs -r kill -9 2>/dev/null || true
            pkill -9 -f '[A]bleton Live.*\.exe|[P]ush2DisplayProcess.exe' 2>/dev/null || true
        fi
    fi

    # The layout migration belongs here: after the stop, which needs WINE_ROOT
    # to still name where running processes execute from, and before staging,
    # which must target where the runtime will now live. Recorded from the
    # pre-state: the migrations are no-ops on a migrated machine, and claiming
    # a migration "stands" where nothing moved is the wrong turn the flag
    # exists to prevent.
    if [ -e "$(works_legacy_root)" ] || [ -L "$(works_legacy_root)" ] || [ -d "$(works_legacy_plug)" ]; then
        migrated=1
    fi
    works_migrate_layout
    works_migrate_plug

    # Where this lands. Unpinned, always the store - a fresh machine never
    # sees the flat layout. Pinned, exactly the named path, flat.
    if [ -n "${WORKS_RUNTIME:-}" ]; then
        STORE=""
        WINE_ROOT="$WORKS_RUNTIME"
        WINE_ROOT_DIR="$(dirname "$WINE_ROOT")"
    else
        STORE="$(works_runtime_store)"
        mkdir -p "$STORE"
    fi

    echo "== stage and validate patched Wine =="
    mkdir -p "$WINE_ROOT_DIR"
    stage="$(mktemp -d "${STORE:-$WINE_ROOT_DIR}/.install.XXXXXX")"
    tar -C "$stage" -I zstd -xf "$tarball"
    local candidate="$stage/$NAME"
    # What Works itself requires of a build: a name, a wine, and the base
    # stamp the guard below reads. Component checks are the caller's voucher.
    [ -n "$(works_runtime_id "$candidate")" ] || {
        echo "!! the staged runtime carries no readable BUILD-INFO, so it cannot be named" >&2; exit 1; }
    [ -x "$candidate/bin/wine" ] || { echo "!! the staged runtime has no bin/wine" >&2; exit 1; }
    [ -f "$candidate/share/wine/wine.inf" ] || {
        echo "!! the staged runtime has no share/wine/wine.inf" >&2; exit 1; }
    if [ -n "$validate" ]; then
        "$validate" "$candidate" || exit 1
    fi

    # --- does this build take any Plug backward? -------------------------------
    # The one door every install passes through, so the guard lives here. The
    # staged candidate is a full tree, so the question is answerable before
    # anything is promoted; the comparison is Wine's own. A pinned
    # WORKS_RUNTIME is exempt: running an old build against a newer prefix is
    # what bisecting is.
    local back fwd roll _plug move
    if [ -z "${WORKS_RUNTIME:-}" ]; then
        back=""; fwd=""; roll=""
        while read -r _plug; do
            [ -n "$_plug" ] || continue
            move="$(works_base_move "$candidate" "$(works_plugs_dir)/$_plug")" || {
                echo "!! $_plug has been booted but will not say which Wine base bootstrapped" >&2
                echo "   it, so whether this build takes it backward cannot be answered." >&2
                echo "   Refusing rather than guessing. Set WORKS_ALLOW_BASE_CHANGE=1 to" >&2
                echo "   install anyway." >&2
                [ "${WORKS_ALLOW_BASE_CHANGE:-0}" = 1 ] || exit 1
                move=""; }
            # refresh - a newer build of the same base - is the ordinary
            # update and passes in silence.
            case "$move" in
                backward) back="$back $_plug" ;;
                forward)  fwd="$fwd $_plug" ;;
                rollback) roll="$roll $_plug" ;;
            esac
        done < <(works_plugs_following "$chan")

        # Going back to an older build of the same base is what the store is
        # for. A note, not a question: wineboot re-runs against the same
        # wine.inf content.
        if [ -n "$roll" ]; then
            echo "   note: this is an older build of the same Wine base; going back for:$roll"
        fi
        # Backward is not a warning: Wine does not support taking a prefix
        # back, so this refuses, and nothing is deleted either way.
        if [ -n "$back" ]; then
            echo "!! This build is on an OLDER Wine base than the Plug(s) it would run:$back" >&2
            echo "   Wine cannot take a prefix back. Those Plugs were bootstrapped against" >&2
            echo "   a newer base and would break." >&2
            if [ "${WORKS_ALLOW_BASE_CHANGE:-0}" != 1 ]; then
                echo "   Refusing. Keep a copy of the Plug and set WORKS_ALLOW_BASE_CHANGE=1" >&2
                echo "   if you mean it, or pick a newer build." >&2
                exit 1
            fi
            echo "   (WORKS_ALLOW_BASE_CHANGE=1 given)"
        fi
        # Forward is supported and is what every base bump is: inform and ask.
        # No terminal proceeds with the notice printed - refusing would break
        # every scripted install the first time a base moves, and there is no
        # unsaved work at stake.
        if [ -n "$fwd" ] && [ "${WORKS_ALLOW_BASE_CHANGE:-0}" != 1 ]; then
            echo "== this build changes the Wine base =="
            echo "   Re-bootstrapped on next launch, and not reversible:$fwd"
            if { : >/dev/tty; } 2>/dev/null; then
                printf 'Continue? [Y/n] ' > /dev/tty
                ans=""
                read -r -t 60 ans < /dev/tty || printf '\n' > /dev/tty 2>/dev/null || true
                case "$ans" in [Nn]*) echo "cancelled"; exit 1 ;; esac
            else
                echo "   (no terminal to ask on; continuing)"
            fi
        fi
    fi

    # Promote. Into the store: file the candidate under the name its own
    # BUILD-INFO gives it, then retarget the channel. No dated rollback
    # directory - the entry one would hold is already in the store under its
    # real name. Never by moving the channel aside: that replaces the channel
    # with a directory and the migration reads the result as already migrated.
    local id
    if [ -n "$STORE" ]; then
        echo "== promote runtime into the store =="
        id="$(works_runtime_id "$candidate")"
        if [ -e "$STORE/$id" ]; then
            # Same build already present. Set it aside rather than write over
            # it, so a failure before the retarget can be undone.
            replaced_orig="$STORE/$id"
            replaced="$STORE/.replaced-$id-$stamp"
            mv "$replaced_orig" "$replaced"
        fi
        mv "$candidate" "$STORE/$id"
        promoted=1
        WINE_ROOT="$STORE/$id"
        ln -sfn "$id" "$STORE/$chan"
        [ -z "$replaced" ] || { rm -rf "$replaced"; replaced=""; replaced_orig=""; }
        echo "   $id  [$chan]"
        # Follow what was last installed: downloading this kit was the choice,
        # and nobody should also have to edit a file to make it stick.
        local _cf
        _cf="$(works_channel_file)"
        mkdir -p "$(dirname "$_cf")" && printf '%s\n' "$chan" > "$_cf"
        # After the promote, never before: an earlier failure must not leave a
        # user with neither the new runtime nor the old one.
        works_prune_runtimes
    else
        echo "== promote runtime with dated rollback =="
        if [ -e "$WINE_ROOT" ]; then
            backup="$WINE_ROOT-rollback-$stamp"
            [ ! -e "$backup" ] || { echo "!! rollback path already exists: $backup" >&2; exit 1; }
            mv "$WINE_ROOT" "$backup"
        fi
        mv "$candidate" "$WINE_ROOT"
        promoted=1
    fi
    "$WINE_ROOT/bin/wine" --version
    )
}

# The shape, then the detail. Written out rather than sliced from the header
# with a line range, which rots the moment the comment above it is edited.
short_usage() {
    cat <<'EOF'
usage: works runtime {list|path|use|install|stop}   `works runtime help` for detail

  works runtime list              every installed build, newest first
  works runtime path              the runtime root, for scripts and docs
  works runtime use [id]          switch the channel to another build
  works runtime install [tarball] this channel's current build, or a local one
  works runtime stop [-y]         stop everything running from the runtime or a Plug
EOF
}

long_usage() {
    cat <<'EOF'
Which build of the runtime is in use, and switching between them.

  works runtime list              every installed build, newest first
  works runtime path              the runtime root, for scripts and docs
  works runtime use               choose from a numbered list
  works runtime use <id>          point the channel at a different build
  works runtime use --previous    the last build that is not the current one
  works runtime use <id> --force  accept a Wine base change unattended
  works runtime install [tarball] [--channel c] [--validate cmd]
                                  no tarball: fetch the channel's manifest,
                                  compare, download and verify, then install;
                                  a tarball skips the web entirely.
                                  --validate runs against the staged tree
  works runtime stop [-y]         stop everything running from the runtime or a Plug
EOF
}

case "${1:-list}" in
    list|ls)        cmd_list ;;
    stop)           shift; cmd_stop "$@" ;;
    path|root)      cmd_path ;;
    install)        shift; cmd_install "$@" ;;
    use|switch)     shift
                    if [ -z "${1:-}" ]; then cmd_pick
                    else cmd_use "$1" "${2:-}"; fi ;;
    -h|--help|help) long_usage ;;
    *) echo "!! unknown command: $1" >&2; short_usage >&2; exit 1 ;;
esac
