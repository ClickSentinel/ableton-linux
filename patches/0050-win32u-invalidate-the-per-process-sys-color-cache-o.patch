Subject: win32u: invalidate the per-process sys-color cache on
 WM_SYSCOLORCHANGE

Each process caches every system color the first time it reads one
(get_rgb_entry gates the registry re-read behind entry->hdr.loaded), and
nothing ever clears that flag again. SetSysColors from another process
updates the registry/volatile key and broadcasts WM_SYSCOLORCHANGE, but a
window that already cached the old value keeps returning it forever: the
forced repaint that follows the broadcast just re-reads the same stale
cache, so a live external SetSysColors call is invisible to any window that
read that color before the call, no matter how different the new value is.

Reset every entry's loaded flag from call_window_proc when WM_SYSCOLORCHANGE
is about to reach a window procedure in the receiving process, so the
repaint that follows re-fetches current values instead of the cached ones.
Also frees any already-created HBRUSH/HPEN cached in system_colors[].brush/
.pen: get_sys_color_brush/_pen wrap whatever get_sys_color() returned at
creation time and never re-check the raw value once cached, so a brush an
app is already using to paint (e.g. the menu bar background) stays stuck on
the old color even after the raw value itself is fixed. Mirrors what
set_rgb_entry already does for the calling process's own SetSysColors.
---
 dlls/win32u/message.c        |  4 ++++
 dlls/win32u/sysparams.c      | 41 ++++++++++++++++++++++++++++++++++++
 dlls/win32u/win32u_private.h |  1 +
 3 files changed, 46 insertions(+)

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index d432eb3c..c90ac890 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2356,6 +2356,10 @@ static LRESULT call_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lpar
     if (!is_current_thread_window( hwnd )) return 0;
     if (!thread_info->client_info) return 0;
 
+    /* runs in the receiving process, right before this message reaches a
+     * window procedure: see reset_sys_color_cache in sysparams.c for why */
+    if (msg == WM_SYSCOLORCHANGE) reset_sys_color_cache();
+
     prev_source = thread_info->client_info->msg_source;
     thread_info->client_info->msg_source = msg_source_unavailable;
 
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index fdcdfc0a..bb4f9d71 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -7303,6 +7303,47 @@ COLORREF get_sys_color( int index )
     return ret;
 }
 
+/* Each process caches every system color the first time it's read (see
+ * get_rgb_entry: entry->hdr.loaded gates the registry re-read), and nothing
+ * ever clears that flag again on its own. A SetSysColors call from another
+ * process updates the registry/volatile key and its own local cache, then
+ * broadcasts WM_SYSCOLORCHANGE — but a window that already cached the old
+ * value keeps returning it forever, even after that broadcast forces a
+ * repaint, because the repaint just re-reads the same stale cache. Called
+ * from call_window_proc for WM_SYSCOLORCHANGE (see message.c), which runs in
+ * the *receiving* process right before that message reaches a window
+ * procedure, so the repaint that follows re-fetches current values instead.
+ *
+ * The raw value isn't the only thing cached: get_sys_color_brush/_pen create
+ * an HBRUSH/HPEN wrapping whatever get_sys_color() returned at the time and
+ * cache *that* separately in system_colors[].brush/.pen, returning it as-is
+ * on every later call with no re-check of the raw value at all. Resetting
+ * .loaded alone fixes get_sys_color() but leaves any already-created brush or
+ * pen stuck on the old color forever — exactly the same bug one level up.
+ * set_rgb_entry already frees these for the *calling* process's own
+ * SetSysColors; mirror that here for the receiving process too. */
+void reset_sys_color_cache(void)
+{
+    unsigned int i;
+    HBRUSH brush;
+    HPEN pen;
+
+    for (i = 0; i < ARRAY_SIZE( system_colors ); i++)
+    {
+        system_colors[i].hdr.loaded = FALSE;
+        if ((brush = InterlockedExchangePointer( (void **)&system_colors[i].brush, 0 )))
+        {
+            make_gdi_object_system( brush, FALSE );
+            NtGdiDeleteObjectApp( brush );
+        }
+        if ((pen = InterlockedExchangePointer( (void **)&system_colors[i].pen, 0 )))
+        {
+            make_gdi_object_system( pen, FALSE );
+            NtGdiDeleteObjectApp( pen );
+        }
+    }
+}
+
 HBRUSH get_55aa_brush(void)
 {
     static const WORD pattern[] = { 0x5555, 0xaaaa, 0x5555, 0xaaaa, 0x5555, 0xaaaa, 0x5555, 0xaaaa };
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index 4e2b9283..1b8e7fd6 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -174,6 +174,7 @@ extern DWORD get_process_layout(void);
 extern COLORREF get_sys_color( int index );
 extern HBRUSH get_sys_color_brush( unsigned int index );
 extern HPEN get_sys_color_pen( unsigned int index );
+extern void reset_sys_color_cache(void);
 extern UINT get_system_dpi(void);
 extern int get_system_metrics( int index );
 extern struct ratio get_thread_dpi(void);
