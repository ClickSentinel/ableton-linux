+#ifndef __WINE_DXGI_SURFACE_OWNER_H
+#define __WINE_DXGI_SURFACE_OWNER_H
+
+/* Set to a non-zero BOOL with IDXGISurface1::SetPrivateData by whoever created
+ * a standalone (non-swapchain) surface and takes responsibility for getting its
+ * pixels to their destination.  Nothing binds a standalone surface to a window,
+ * so dxgi's ReleaseDC otherwise falls back to enumerating the desktop for a
+ * window whose client area matches the surface.  An owner that already delivers
+ * its own pixels, such as an ID2D1DCRenderTarget blitting to the application's
+ * device context, makes that search both pointless and a source of stray blits
+ * into unrelated same-sized windows. */
+static const GUID WINE_DXGI_SURFACE_OWNER_PRESENTS =
+        {0x5b3f9c14,0x7ad2,0x4e6b,{0x9f,0x21,0xc8,0x4d,0x0e,0x77,0xb3,0x52}};
+
+#endif  /* __WINE_DXGI_SURFACE_OWNER_H */
