Subject: wined3d: describe unlisted GPUs from the driver's own
 renderer string

A device that is not in gpu_description_table falls through to guessing
a device from the feature level, which names a card from roughly 2010.
A Radeon RX 7900 XT is reported as "ATI Radeon HD 5600 Series", and any
Intel GPU newer than the table becomes "Intel(R) HD Graphics 4000":

  trace:d3d:query_gpu_description Card reports vendor PCI ID 0x1002,
      device PCI ID 0x744c, 0x500000000 bytes of video memory.
  trace:d3d:wined3d_guess_card Unrecognized renderer "AMD Radeon RX 7900 XT
      (radeonsi, navi31, ACO, DRM 3.64, ...)", falling back to default.
  trace:d3d:wined3d_adapter_init_gl_caps Guessed device PCI ID 0x68d8.

The information needed to do better is already in hand at that point:
GLX_MESA_query_renderer has just supplied the real PCI IDs and video
memory, and GL_RENDERER carries the device name. Only the table lookup
is missing an entry, so synthesise the description from what the driver
reports instead of discarding it.

The Vulkan back end already works this way, using
VkPhysicalDeviceProperties.deviceName; this gives the OpenGL back end
the same behaviour. A user override still takes precedence, and a device
that is in the table is unaffected, so the change is confined to the case
that is currently answered with a wrong card.

This matters beyond a cosmetic name. Applications gate behaviour on the
reported device: Ableton Live 12 refuses to enable its GPU renderer when
it is told the card is an "Intel(R) HD Graphics 4000", so every Intel GPU
released since 2019 loses hardware rendering until an entry is added by
hand (ableton-linux issue 84). Games size buffers and select quality
presets the same way.

Origin: local fix for ableton-linux issue #84. Should also be upstreamed
to Wine, where it applies to all three vendors.
---
 dlls/wined3d/adapter_gl.c | 81 ++++++++++++++++++++++++++++++++++++---
 dlls/wined3d/wined3d_gl.h |  6 +++
 2 files changed, 82 insertions(+), 5 deletions(-)

diff --git a/dlls/wined3d/adapter_gl.c b/dlls/wined3d/adapter_gl.c
index 1ce8879..3cbffc7 100644
--- a/dlls/wined3d/adapter_gl.c
+++ b/dlls/wined3d/adapter_gl.c
@@ -989,8 +989,67 @@ static void quirk_no_independent_bit_depths(struct wined3d_gl_info *gl_info)
     gl_info->quirks |= WINED3D_QUIRK_NO_INDEPENDENT_BIT_DEPTHS;
 }
 
+static enum wined3d_display_driver guess_display_driver(enum wined3d_pci_vendor vendor)
+{
+    switch (vendor)
+    {
+        case HW_VENDOR_AMD:    return DRIVER_AMD_RX;
+        case HW_VENDOR_INTEL:  return DRIVER_INTEL_HD4000;
+        case HW_VENDOR_NVIDIA: return DRIVER_NVIDIA_GEFORCE8;
+        default:               return DRIVER_WINE;
+    }
+}
+
+/* Build a description from the name the driver reports for itself, for a
+ * device that is not in gpu_description_table.
+ *
+ * Without this the caller falls back to guessing a device from the feature
+ * level, which names a decade-old card: a Radeon RX 7900 XT is reported as
+ * "ATI Radeon HD 5600 Series", and every Intel GPU newer than the table
+ * becomes "Intel(R) HD Graphics 4000". Applications that gate behaviour on
+ * the reported device therefore see hardware that is nothing like the real
+ * card, and the table can only ever be as current as its last update.
+ *
+ * The Vulkan back end already does this, using
+ * VkPhysicalDeviceProperties.deviceName (see wined3d_adapter_vk_init_driver_info);
+ * this is the OpenGL equivalent, using GL_RENDERER. */
+static const struct wined3d_gpu_description *synthesise_gpu_description(struct wined3d_caps_gl_ctx *ctx,
+        enum wined3d_pci_vendor vendor, enum wined3d_pci_device device, const char *gl_renderer)
+{
+    const char *name = gl_renderer, *end;
+    size_t len;
+
+    /* Mesa reports "Mesa <device> (<driver>, <kernel version>, ...)". A
+     * Windows driver reports neither the library name nor the parenthesised
+     * build detail, so keep just the device part. */
+    if (!strncmp(name, "Mesa ", 5))
+        name += 5;
+    if ((end = strstr(name, " (")))
+        len = end - name;
+    else
+        len = strlen(name);
+
+    if (!len)
+        return NULL;
+    if (len >= sizeof(ctx->synthetic_description))
+        len = sizeof(ctx->synthetic_description) - 1;
+    memcpy(ctx->synthetic_description, name, len);
+    ctx->synthetic_description[len] = '\0';
+
+    ctx->synthetic_gpu_description.vendor = vendor;
+    ctx->synthetic_gpu_description.device = device;
+    ctx->synthetic_gpu_description.description = ctx->synthetic_description;
+    ctx->synthetic_gpu_description.driver = guess_display_driver(vendor);
+    ctx->synthetic_gpu_description.vidmem = ctx->vram_bytes / (1024 * 1024);
+
+    TRACE("Device %04x:%04x is not in the description table; reporting it as %s.\n",
+            vendor, device, debugstr_a(ctx->synthetic_description));
+
+    return &ctx->synthetic_gpu_description;
+}
+
 static const struct wined3d_gpu_description *query_gpu_description(const struct wined3d_gl_info *gl_info,
-        UINT64 *vram_bytes)
+        struct wined3d_caps_gl_ctx *ctx, const char *gl_renderer)
 {
     const struct wined3d_gpu_description *gpu_description = NULL, *gpu_description_override;
     enum wined3d_pci_vendor vendor = PCI_VENDOR_NONE;
@@ -1004,12 +1063,24 @@ static const struct wined3d_gpu_description *query_gpu_description(const struct
         if (GL_EXTCALL(wglQueryCurrentRendererIntegerWINE(WGL_RENDERER_DEVICE_ID_WINE, &value)))
             device = value;
         if (GL_EXTCALL(wglQueryCurrentRendererIntegerWINE(WGL_RENDERER_VIDEO_MEMORY_WINE, &value)))
-            *vram_bytes = (UINT64)value * 1024 * 1024;
+            ctx->vram_bytes = (UINT64)value * 1024 * 1024;
 
         TRACE("Card reports vendor PCI ID 0x%04x, device PCI ID 0x%04x, 0x%s bytes of video memory.\n",
-                vendor, device, wine_dbgstr_longlong(*vram_bytes));
+                vendor, device, wine_dbgstr_longlong(ctx->vram_bytes));
 
-        gpu_description = wined3d_get_gpu_description(vendor, device);
+        /* A real PCI ID is 16 bits. Mesa reports 0xffffffff for a renderer
+         * that is not a PCI device at all - llvmpipe, for instance - and
+         * those have no business being described as a graphics card, so
+         * leave them to the existing feature-level fallback.
+         *
+         * The attributes are queried independently, so also require the video
+         * memory: a description built without it would report zero bytes of
+         * video memory, where the feature-level fallback at least carries the
+         * table's approximation. */
+        if (!(gpu_description = wined3d_get_gpu_description(vendor, device)) && gl_renderer
+                && ctx->vram_bytes
+                && (unsigned int)vendor < PCI_VENDOR_NONE && (unsigned int)device < PCI_DEVICE_NONE)
+            gpu_description = synthesise_gpu_description(ctx, vendor, device, gl_renderer);
     }
 
     if ((gpu_description_override = wined3d_get_user_override_gpu_description(vendor, device)))
@@ -3788,7 +3859,7 @@ static BOOL wined3d_adapter_init_gl_caps(struct wined3d_adapter_gl *adapter_gl,
     gl_vendor = wined3d_guess_gl_vendor(gl_info, gl_vendor_str, gl_renderer_str, gl_version_str);
     TRACE("Guessed GL vendor %#x.\n", gl_vendor);
 
-    if (!(caps_gl_ctx->gpu_description = query_gpu_description(gl_info, &caps_gl_ctx->vram_bytes)))
+    if (!(caps_gl_ctx->gpu_description = query_gpu_description(gl_info, caps_gl_ctx, gl_renderer_str)))
     {
         enum wined3d_feature_level feature_level;
         struct fragment_caps fragment_caps;
diff --git a/dlls/wined3d/wined3d_gl.h b/dlls/wined3d/wined3d_gl.h
index 3b7c9fb..6f83605 100644
--- a/dlls/wined3d/wined3d_gl.h
+++ b/dlls/wined3d/wined3d_gl.h
@@ -809,6 +809,12 @@ struct wined3d_caps_gl_ctx
     GLuint test_program_id;
 
     const struct wined3d_gpu_description *gpu_description;
+    /* Backing store for a description synthesised from the driver's own
+     * renderer string, for a device that is not in gpu_description_table.
+     * gpu_description points here in that case, and the caps context
+     * outlives wined3d_adapter_init_gl_caps(), so it cannot be a local. */
+    struct wined3d_gpu_description synthetic_gpu_description;
+    char synthetic_description[128];
     UINT64 vram_bytes;
 };
 
