+                    return hr;
+                }
+                p.result = copy_engine_delete(operation, op);
+                if (FAILED((hr = file_operation_notify(operation, op, TRUE, &p, notify_post_delete_item))))
+                {
+                    IShellItem_Release(p.item);
+                    return hr;
+                }
+                hr = p.result;
+                IShellItem_Release(p.item);
+                break;
+            }
