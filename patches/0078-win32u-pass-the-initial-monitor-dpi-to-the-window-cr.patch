Subject: win32u: pass the initial monitor DPI to the window creation request

Backport of Wine MR 11573 by Rémi Bernon, proposed upstream as the
fix for bug 60023: windows created by a per-monitor-DPI-aware process
are sized at 1 / (LogPixels / 96)^2 of their request, a regression
between Wine 11.12 and 11.13. The server created every window at the
default 96 DPI and corrected it only later, so the first rectangle
conversions ran against the wrong monitor DPI.

Pass the creating thread's monitor DPI in the create_window request
and seed the server-side window with it. The desktop and message
windows take the primary monitor's DPI when one exists.

Adaptations from the upstream commit: get_monitor_from_rect takes an
int in 11.13, and the regenerated protocol files are included, with
SERVER_PROTOCOL_VERSION raised from 956 to 957 because the
create_window request grows two fields.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60023
Upstream-commit: 8ba41b5eed459649ab7e3436738a534168aed5e1 (MR 11573, unmerged as of 2026-08-06)

diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index e07a3b5..5110d70 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -5851,24 +5851,31 @@ void destroy_thread_windows(void)
  * Create a window handle with the server.
  */
 static WND *create_window_handle( HWND parent, HWND owner, UNICODE_STRING *name, HINSTANCE class_instance,
-                                  HINSTANCE instance, BOOL ansi, DWORD style, DWORD ex_style )
+                                  const CREATESTRUCTW *cs, BOOL ansi, DWORD style, DWORD ex_style )
 {
+    RECT rect = { cs->x, cs->y, cs->x + cs->cx, cs->y + cs->cy };
     UINT dpi_context = get_thread_dpi_awareness_context();
     HWND handle = 0, full_parent = 0, full_owner = 0;
     struct tagCLASS *class = NULL;
+    struct ratio dpi, raw_dpi;
     WND *win;
 
+    if (parent && parent != get_desktop_window()) dpi = get_win_monitor_dpi( parent, &raw_dpi );
+    else dpi = monitor_dpi_from_rect( rect, get_thread_dpi(), &raw_dpi );
+
     SERVER_START_REQ( create_window )
     {
         req->parent          = wine_server_user_handle( parent );
         req->owner           = wine_server_user_handle( owner );
         req->class_instance  = wine_server_client_ptr( class_instance );
-        req->instance        = wine_server_client_ptr( instance );
+        req->instance        = wine_server_client_ptr( cs->hInstance );
         req->dpi_context     = dpi_context;
         req->style           = style;
         req->ex_style        = ex_style;
         req->ansi            = ansi;
         req->atom            = wine_server_add_atom( req, name );
+        req->dpi             = dpi;
+        req->raw_dpi         = raw_dpi;
         if (!wine_server_call_err( req ))
         {
             handle      = wine_server_ptr_handle( reply->handle );
@@ -6088,7 +6095,7 @@ HWND WINAPI NtUserCreateWindowEx( DWORD ex_style, UNICODE_STRING *class_name,
     style = cs.style & ~WS_VISIBLE;
     ex_style = cs.dwExStyle & ~WS_EX_LAYERED;
     if (!(win = create_window_handle( parent, owner, class_name, class_instance,
-                                      cs.hInstance, ansi, style, ex_style )))
+                                      &cs, ansi, style, ex_style )))
         return 0;
     hwnd = win->handle;
 
